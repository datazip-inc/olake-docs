{
  // Checked by `npm run typecheck`. Node runs these files as they are, so only syntax that can be
  // erased is allowed, and imports name the .ts file.
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["ingest", "test"]
}
