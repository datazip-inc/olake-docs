{
  // Ask OLake, the backend of the chat widget and the Slack bot. Separate from ../wrangler.jsonc,
  // which is the site.
  //
  //   npx wrangler dev --local    runs it on this machine. --local leaves out Workers AI, which
  //                               only runs at Cloudflare: the search is then by keyword only.
  "name": "ask-olake",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // The index and the log of questions. `npm run ask-olake:index` fills the local copy, kept
  // under .wrangler/.
  "d1_databases": [{ "binding": "DB", "database_name": "ask-olake" }],
  // Embeds each question for meaning search.
  "ai": { "binding": "AI" },
  // One visitor (an address, or a Slack user) may ask 10 questions a minute.
  "ratelimits": [
    { "name": "RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  // Secrets are not listed here: OPENROUTER_API_KEY, and SLACK_SIGNING_SECRET and SLACK_BOT_TOKEN
  // once the Slack app exists. .env.local holds them for `wrangler dev`.
  "vars": {
    // The sites whose pages may call the API.
    "ALLOWED_ORIGINS": "https://olake.io,http://localhost:3000,http://localhost:3210",
    // The most the model calls of one day may cost, in US dollars. About 2,000 answers.
    "DAILY_BUDGET_USD": "3"
  }
}
