{
  // Ask OLake, the backend of the chat widget. Separate from ../wrangler.jsonc, which is the site.
  "name": "ask-olake",
  "compatibility_date": "2026-11-01",
  // The index. `npm run ask-olake:index` fills the local copy, kept under .wrangler/.
  "d1_databases": [{ "binding": "DB", "database_name": "ask-olake" }]
}
