{
  // Ask OLake, the backend of the chat widget. Separate from ../wrangler.jsonc, which is the site.
  "name": "ask-olake",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // The index. `npm run ask-olake:index` fills the local copy, kept under .wrangler/.
  "d1_databases": [{ "binding": "DB", "database_name": "ask-olake" }],
  // The sites whose pages may call the API. The OpenRouter key is a secret, not a variable:
  // .env.local holds it for `wrangler dev`.
  "vars": { "ALLOWED_ORIGINS": "https://olake.io,http://localhost:3000,http://localhost:3210" }
}
