# Copy to .env for local testing. On Render, enter the same keys under Environment.
# The key comes from the OLake event (sent on Slack, starts with sk-or-v1-). Never commit it.
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# Only these three models work on the event key (any other model returns 403)
# Order chosen by our eval (organizers allow reordering): DeepSeek most accurate + fast
LLM_MODEL=deepseek/deepseek-v4.1-flash
LLM_FALLBACK_MODELS=google/gemini-2.5-flash-lite,z-ai/glm-4.7-flash
MAX_ANSWER_TOKENS=800
# Local embedding model (runs inside our server, no API cost); empty = keyword (BM25) search only
EMBEDDING_MODEL=minishlab/potion-base-8M

# GitHub fine-grained PAT, "Public repositories (read-only)", no other permissions.
# Used to fetch GitHub issues and for live refresh change detection.
GITHUB_TOKEN=
# Live refresh: poll OLake sources every N seconds and hot-swap the index (LIVE_REFRESH=0 to disable)
LIVE_REFRESH=1
REFRESH_INTERVAL_S=600
# While a docs commit is waiting for the website to redeploy, retry this often instead
REFRESH_PENDING_RETRY_S=300
# Protects POST /admin/refresh: a manual trigger (Authorization: Bearer <REFRESH_TOKEN>)
# or a GitHub webhook signed with WEBHOOK_SECRET. Use long random strings.
REFRESH_TOKEN=
# GitHub webhook: set this to the secret you enter in GitHub repo Settings → Webhooks.
# The /webhook/github endpoint uses this to verify push events from GitHub.
WEBHOOK_SECRET=
# Only pushes to this branch trigger a re-index. Leave empty to trigger on any branch.
WEBHOOK_BRANCH=main
