{
  // Used by `npm run typecheck` (tsc --noEmit) and by editors. Docusaurus compiles with its own loader.
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    // New JSX transform: files do not need `import React` for the editor to accept JSX
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    // baseUrl and paths in the base config resolve relative to node_modules/@docusaurus/tsconfig,
    // so they must be repeated here to point at this repo's root.
    "baseUrl": ".",
    "paths": {
      "@site/*": ["./*"]
    },
    "types": ["node", "@docusaurus/module-type-aliases", "@docusaurus/theme-classic"]
  },
  "exclude": [".docusaurus", "build", "node_modules"]
}
