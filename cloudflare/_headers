# Response headers for olake.io on Cloudflare Workers static assets.
# scripts/cloudflare/prepare-build.mjs copies this file to build/_headers.
# Syntax and limits (100 rules): https://developers.cloudflare.com/workers/static-assets/headers/

# Docusaurus puts a content hash in every file name under /assets/, so these never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Not hashed, and screenshots are replaced in place: one hour, then stale while revalidating.
/img/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/fonts/*
  Cache-Control: public, max-age=2592000

/videos/*
  Cache-Control: public, max-age=86400

# HTML, sitemap.xml, robots.txt and llms.txt get no rule on purpose: Cloudflare's default
# "public, max-age=0, must-revalidate" with an ETag makes the browser ask on every load, so a
# visitor never keeps the HTML of an older deploy.

# The not-found page also answers 200 at /404
/404
  X-Robots-Tag: noindex

# The list carry-assets.mjs reads on the next deploy
/asset-manifest.json
  Cache-Control: no-store
  X-Robots-Tag: noindex

/*
  Strict-Transport-Security: max-age=31556952
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# workers.dev hosts (the Worker's own URL and version URLs) must never be indexed
https://:worker.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
