-- The Flink SQL job of this test. run.sh fills in three markers, each written between two at signs:
--   NAME     the name of the job
--   SET      extra SET statements (the savepoint to restore from, a restart strategy)
--   OPTIONS  extra options of the two source tables (a startup mode, a Debezium property)
SET 'pipeline.name' = '@NAME@';
SET 'execution.checkpointing.interval' = '5s';
@SET@

CREATE TABLE customers (
  id INT,
  first_name STRING,
  last_name STRING,
  email STRING,
  PRIMARY KEY (id) NOT ENFORCED
) WITH (
  'connector' = 'mysql-cdc',
  'hostname' = 'source',
  'port' = '3306',
  'username' = 'flinkcdc',
  'password' = 'labpw',
  'database-name' = 'inventory',
  'table-name' = 'customers',
  'server-id' = '5401',
  @OPTIONS@
  'server-time-zone' = 'UTC'
);

CREATE TABLE orders (
  id INT,
  customer_id INT,
  quantity INT,
  placed_at TIMESTAMP(0),
  PRIMARY KEY (id) NOT ENFORCED
) WITH (
  'connector' = 'mysql-cdc',
  'hostname' = 'source',
  'port' = '3306',
  'username' = 'flinkcdc',
  'password' = 'labpw',
  'database-name' = 'inventory',
  'table-name' = 'orders',
  'server-id' = '5402',
  @OPTIONS@
  'server-time-zone' = 'UTC'
);

-- The sink prints every change to the TaskManager's standard output.
CREATE TABLE customers_out (id INT, first_name STRING, last_name STRING, email STRING)
  WITH ('connector' = 'print', 'print-identifier' = 'customers');
CREATE TABLE orders_out (id INT, customer_id INT, quantity INT, placed_at TIMESTAMP(0))
  WITH ('connector' = 'print', 'print-identifier' = 'orders');

EXECUTE STATEMENT SET
BEGIN
  INSERT INTO customers_out SELECT * FROM customers;
  INSERT INTO orders_out SELECT * FROM orders;
END;
