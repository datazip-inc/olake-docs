-- The Flink SQL job of this test. run.sh fills in the markers, each written between two at signs:
--   NAME      the name of the job, also printed in front of every row
--   SET       extra SET statements
--   DATABASE  cdclab, or cdclab2 for the run with the Agent off
--   COLUMNS   "note STRING," when the job declares the new column, otherwise nothing
--   OPTIONS   extra options of the source table
SET 'pipeline.name' = '@NAME@';
SET 'execution.checkpointing.interval' = '5s';
@SET@

CREATE TABLE orders (
  id INT,
  customer_id INT,
  quantity INT,
  placed_at TIMESTAMP(0),
  @COLUMNS@
  PRIMARY KEY (id) NOT ENFORCED
) WITH (
  'connector' = 'sqlserver-cdc',
  'hostname' = 'mssql',
  'port' = '1433',
  'username' = 'sa',
  'password' = 'Lab_Passw0rd_2026',
  'database-name' = '@DATABASE@',
  @OPTIONS@
  'table-name' = 'dbo.orders'
);

-- The sink prints every change to the TaskManager's standard output.
CREATE TABLE orders_out (id INT, customer_id INT, quantity INT, placed_at TIMESTAMP(0)@OUTCOLUMNS@)
  WITH ('connector' = 'print', 'print-identifier' = '@NAME@');

INSERT INTO orders_out SELECT * FROM orders;
