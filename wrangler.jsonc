{
  // olake.io on Cloudflare Workers static assets. There is no Worker code: every request is
  // answered from build/ (after scripts/cloudflare/prepare-build.mjs), so requests are not billed.
  "name": "olake-docs",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./build",
    // /docs/ serves docs/index.html. The /docs -> /docs/ redirect comes from build/_redirects (301).
    "html_handling": "auto-trailing-slash",
    // Unknown paths answer 404 with build/404.html
    "not_found_handling": "404-page"
  },
  // The workers.dev URL is used to check a deploy before the domain is moved. cloudflare/_headers
  // marks it noindex. Set this to false once olake.io is served from here.
  "workers_dev": true,
  "preview_urls": true,
  "previews": {}
  // DO NOT add a "routes" entry with "custom_domain": true until cutover day:
  // the first deploy that carries it moves olake.io to this Worker.
}
