{
  // olake.io on Cloudflare Workers static assets. There is no Worker code: every request is
  // answered from build/ (after scripts/cloudflare/prepare-build.mjs), so requests are not billed.
  "name": "olake-docs",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./build",
    // /docs/ serves docs/index.html. The /docs -> /docs/ redirect comes from build/_redirects (301).
    "html_handling": "auto-trailing-slash",
    // Unknown paths answer 404 with build/404.html
    "not_found_handling": "404-page"
  },
  // olake.io is served from this Worker. Cloudflare owns the DNS records and the certificate of a
  // custom domain. Removing this entry detaches the domain on the next deploy.
  "routes": [{ "pattern": "olake.io", "custom_domain": true }],
  // olake.io is the only public address. Preview URLs (pull requests) stay on workers.dev, and
  // cloudflare/_headers marks every workers.dev host noindex.
  "workers_dev": false,
  "preview_urls": true,
  "previews": {}
}
