"25" as="geometry"/></mxCell><mxCell id="p08n88" value="&lt;font style=&quot;font-size: 11px&quot; color=&quot;#0B1220&quot;&gt;Dan&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#0B1220;" vertex="1" parent="p08n66"><mxGeometry x="144" y="77" width="90" height="25" as="geometry"/></mxCell><mxCell id="p08n89" value="&lt;font style=&quot;font-size: 11px&quot; color=&quot;#0B1220&quot; face=&quot;Courier New&quot;&gt;r&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Courier New;fontSize=11;fontColor=#0B1220;" vertex="1" parent="p08n66"><mxGeometry x="244" y="77" width="80" height="25" as="geometry"/></mxCell><mxCell id="p08n90" value="" style="shape=line;direction=north;strokeColor=#DEE5EE;strokeWidth=1;fillColor=none;" vertex="1" parent="p08n66"><mxGeometry x="92" y="0" width="1" height="102" as="geometry"/></mxCell><mxCell id="p08n91" value="" style="shape=line;direction=north;strokeColor=#DEE5EE;strokeWidth=1;fillColor=none;" vertex="1" parent="p08n66"><mxGeometry x="136" y="0" width="1" height="102" as="geometry"/></mxCell><mxCell id="p08n92" value="" style="shape=line;direction=north;strokeColor=#DEE5EE;strokeWidth=1;fillColor=none;" vertex="1" parent="p08n66"><mxGeometry x="236" y="0" width="1" height="102" as="geometry"/></mxCell><mxCell id="p08n93" value="one row for id 2 — not two" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10.4;fontColor=#5A6B82;" vertex="1" parent="1"><mxGeometry x="1336" y="579" width="326" height="20.4" as="geometry"/></mxCell><mxCell id="p08n94" value="" style="html=1;edgeStyle=none;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=2.6;strokeColor=#059669;fontFamily=Helvetica;fontSize=11;fontColor=#046B4D;labelBackgroundColor=none;verticalAlign=bottom;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="p08n62" target="p08n66"><mxGeometry relative="1" as="geometry"><mxPoint x="1497" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p08n95" value="The backfill writes Bob as a plain append (op r) and the replay hands him over again inside the overlap window (op i). Because both hash to the same _olake_id, the writer emits an equality delete plus a fresh data file, one commit applies both,&lt;br/&gt;and the table ends with a single row 2." style="text;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12.5;fontColor=#5A6B82;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="70" y="750" width="1580" height="38.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p09" name="09 · What a record carries"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="720" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p09n1" value="Every record carries its own provenance" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=21;fontColor=#0B1220;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="56" y="24" width="1380" height="30" as="geometry"/></mxCell><mxCell id="p09n2" value="OLake stamps four metadata columns onto each row, plus the exact log position for CDC" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12.5;fontColor=#5A6B82;" vertex="1" parent="1"><mxGeometry x="56" y="57" width="1380" height="18" as="geometry"/></mxCell><mxCell id="p09n3" value="olake.io" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#BAC5D4;" vertex="1" parent="1"><mxGeometry x="1552" y="28" width="120" height="16" as="geometry"/></mxCell><mxCell id="p09n4" value="" style="group" vertex="1" connectable="0" parent="1"><mxGeometry x="56" y="156" width="350" height="52" as="geometry"/></mxCell><mxCell id="p09n5" value="source row, as the database has it" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11.5;fontColor=#33445A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="130" width="350" height="18" as="geometry"/></mxCell><mxCell id="p09n6" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#475A70;strokeWidth=1.6;" vertex="1" parent="p09n4"><mxGeometry x="0" y="0" width="350" height="52" as="geometry"/></mxCell><mxCell id="p09n7" value="" style="rounded=0;html=1;fillColor=#E6EBF2;strokeColor=#475A70;strokeWidth=1.6;" vertex="1" parent="p09n4"><mxGeometry x="0" y="0" width="350" height="27" as="geometry"/></mxCell><mxCell id="p09n8" value="&lt;b&gt;&lt;font style=&quot;font-size: 10.5px&quot; color=&quot;#33445A&quot; face=&quot;Courier New&quot;&gt;id&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10.5;fontColor=#33445A;" vertex="1" parent="p09n4"><mxGeometry x="8" y="0" width="40" height="27" as="geometry"/></mxCell><mxCell id="p09n9" value="&lt;b&gt;&lt;font style=&quot;font-size: 10.5px&quot; color=&quot;#33445A&quot;&gt;customer&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10.5;fontColor=#33445A;" vertex="1" parent="p09n4"><mxGeometry x="58" y="0" width="90" height="27" as="geometry"/></mxCell><mxCell id="p09n10" value="&lt;b&gt;&lt;font style=&quot;font-size: 10.5px&quot; color=&quot;#33445A&quot; face=&quot;Courier New&quot;&gt;amount&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10.5;fontColor=#33445A;" vertex="1" parent="p09n4"><mxGeometry x="158" y="0" width="80" height="27" as="geometry"/></mxCell><mxCell id="p09n11" value="&lt;b&gt;&lt;font style=&quot;font-size: 10.5px&quot; color=&quot;#33445A&quot; face=&quot;Courier New&quot;&gt;updated_at&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10.5;fontColor=#33445A;" vertex="1" parent="p09n4"><mxGeometry x="248" y="0" width="100" height="27" as="geometry"/></mxCell><mxCell id="p09n12" value="" style="shape=line;strokeColor=#DEE5EE;strokeWidth=1;fillColor=none;" vertex="1" parent="p09n4"><mxGeometry x="0" y="27" width="350" height="1" as="geometry"/></mxCell><mxCell id="p09n13" value="&lt;font style=&quot;font-size: 11px&quot; color=&quot;#0B1220&quot; face=&quot;Courier New&quot;&gt;2&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Courier New;fontSize=11;fontColor=#0B1220;" vertex="1" parent="p09n4"><mxGeometry x="8" y="27" width="40" height="25" as="geometry"/></mxCell><mxCell id="p09n14" value="&lt;font style=&quot;font-size: 11px&quot; color=&quot;#0B1220&quot;&gt;Bob&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#0B1220;" vertex="1" parent="p09n4"><mxGeometry x="58" y="27" width="90" height="25" as="geometry"/></mxCell><mxCell id="p09n15" value="&lt;font style=&quot;font-size: 11px&quot; color=&quot;#0B1220&quot; face=&quot;Courier New&quot;&gt;340.00&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Courier New;fontSize=11;fontColor=#0B1220;" vertex="1" parent="p09n4"><mxGeometry x="158" y="27" width="80" height="25" as="geometry"/></mxCell><mxCell id="p09n16" value="&lt;font style=&quot;font-size: 11px&quot; color=&quot;#0B1220&quot; face=&quot;Courier New&quot;&gt;09:02:11&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Courier New;fontSize=11;fontColor=#0B1220;" vertex="1" parent="p09n4"><mxGeometry x="248" y="27" width="100" height="25" as="geometry"/></mxCell><mxCell id="p09n17" value="" style="shape=line;direction=north;strokeColor=#DEE5EE;strokeWidth=1;fillColor=none;" vertex="1" parent="p09n4"><mxGeometry x="50" y="0" width="1" height="52" as="geometry"/></mxCell><mxCell id="p09n18" value="" style="shape=line;direction=north;strokeColor=#DEE5EE;strokeWidth=1;fillColor=none;" vertex="1" parent="p09n4