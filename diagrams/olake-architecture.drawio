ntFamily=Courier New;fontSize=11;fontColor=#046B4D;" vertex="1" parent="p00n132"><mxGeometry x="162" y="52" width="80" height="25" as="geometry"/></mxCell><mxCell id="p00n147" value="" style="shape=line;direction=north;strokeColor=#DEE5EE;strokeWidth=1;fillColor=none;" vertex="1" parent="p00n132"><mxGeometry x="50" y="0" width="1" height="77" as="geometry"/></mxCell><mxCell id="p00n148" value="" style="shape=line;direction=north;strokeColor=#DEE5EE;strokeWidth=1;fillColor=none;" vertex="1" parent="p00n132"><mxGeometry x="154" y="0" width="1" height="77" as="geometry"/></mxCell><mxCell id="p00n149" value="a worked example beats an abstract box" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10.4;fontColor=#5A6B82;" vertex="1" parent="1"><mxGeometry x="700" y="768" width="300" height="20.4" as="geometry"/></mxCell><mxCell id="p00n150" value="EDGES · line style is meaning" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11.5;fontColor=#33445A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1060" y="646" width="420" height="18" as="geometry"/></mxCell><mxCell id="p00n151" value="" style="html=1;edgeStyle=none;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.8;strokeColor=#33445A;fontFamily=Helvetica;fontSize=11;fontColor=#33445A;labelBackgroundColor=none;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="690" as="sourcePoint"/><mxPoint x="1240" y="690" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p00n152" value="data flow — solid slate" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#5A6B82;" vertex="1" parent="1"><mxGeometry x="1256" y="680" width="400" height="20" as="geometry"/></mxCell><mxCell id="p00n153" value="" style="html=1;edgeStyle=none;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.8;strokeColor=#D97706;fontFamily=Helvetica;fontSize=11;fontColor=#9A5408;labelBackgroundColor=none;verticalAlign=bottom;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="724" as="sourcePoint"/><mxPoint x="1240" y="724" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p00n154" value="state &amp; metadata — dashed amber" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#5A6B82;" vertex="1" parent="1"><mxGeometry x="1256" y="714" width="400" height="20" as="geometry"/></mxCell><mxCell id="p00n155" value="" style="html=1;edgeStyle=none;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=2.6;strokeColor=#059669;fontFamily=Helvetica;fontSize=11;fontColor=#046B4D;labelBackgroundColor=none;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="758" as="sourcePoint"/><mxPoint x="1240" y="758" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p00n156" value="atomic commit — bold green" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#5A6B82;" vertex="1" parent="1"><mxGeometry x="1256" y="748" width="400" height="20" as="geometry"/></mxCell><mxCell id="p00n157" value="" style="html=1;edgeStyle=none;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.8;strokeColor=#DC2626;fontFamily=Helvetica;fontSize=11;fontColor=#A81C1C;labelBackgroundColor=none;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="792" as="sourcePoint"/><mxPoint x="1240" y="792" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p00n158" value="failure path — red, sparingly" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#5A6B82;" vertex="1" parent="1"><mxGeometry x="1256" y="782" width="400" height="20" as="geometry"/></mxCell><mxCell id="p00n159" value="TYPE · one family, four sizes" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11.5;fontColor=#33445A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="56" y="896" width="420" height="18" as="geometry"/></mxCell><mxCell id="p00n160" value="Page title — 21 bold" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=21;fontColor=#0B1220;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="56" y="924" width="500" height="30" as="geometry"/></mxCell><mxCell id="p00n161" value="Node name — 13 bold" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#0B1220;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="56" y="958" width="500" height="20" as="geometry"/></mxCell><mxCell id="p00n162" value="Secondary detail — 11 slate" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#5A6B82;" vertex="1" parent="1"><mxGeometry x="56" y="982" width="500" height="18" as="geometry"/></mxCell><mxCell id="p00n163" value="GetOrSplitChunks() — 11 mono for code" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Courier New;fontSize=11;fontColor=#5A6B82;" vertex="1" parent="1"><mxGeometry x="56" y="1004" width="500" height="18" as="geometry"/></mxCell><mxCell id="p00n164" value="RULES" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11.5;fontColor=#33445A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="896" width="420" height="18" as="geometry"/></mxCell><mxCell id="p00n165" value="1  One meaning per shape and colour — on every page, without exception." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11.5;fontColor=#0B1220;" vertex="1" parent="1"><mxGeometry x="700" y="926" width="980" height="20" as="geometry"/></mxCell><mxCell id="p00n166" value="2  Flow reads left → right; stacks read top → bottom. Never both at once." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11.5;fontColor=#0B1220;" vertex="1" parent="1"><mxGeometry x="700" y="952" width="980" height="20" as="geometry"/></mxCell><mxCell id="p00n167" value="3  Solid = data, dashed amber = state, bold green = commit. Label arrows with verbs." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11.5;fontColor=#0B1220;" vertex="1" parent="1"><mxGeometry x="700" y="978" width="980" height="20" as="geometry"/></mxCell><mxCell id="p00n168" value="4  Real values in every shape: ctid ranges, LSNs, id 2 · Bob. Never lorem boxes." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11.5;fontColor=#0B1220;" vertex="1" parent="1"><mxGeometry x="700" y="1004" width="980" height="20" as="geometry"/></mxCell><mxCell id="p00n169" value="5  Vendor marks identify systems; the shape still carries the meaning." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11.5;fontColor=#0B1220;" vertex="1" parent="1"><mxGeometry x="700" y="1030" width="980" height="20" as="geometry"/></mxCell><mxCell id="p00n170" value="6  ≤ 12 primary nodes per page. Split rather than shrink the type." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11.5;fontColor=#0B1220;" vertex="1" parent="1"><mxGeometry x="700" y="1056" width="980" height="20" as="geometry"/></mxCell><mxCell id="p00n171" value="7  Every page: a title, one-sentence caption, and numbered steps if order matters." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11.5;fontColor=#0B1220;" vertex="1" parent="1"><mxGeometry x="700" y="1082" width="980" height="20" as="geometry"/></mxCell><mxCell id="p00n172" value="8  A new concept gets its symbol added to this page first." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11.5;fontColor=#0B1220;" vertex="1" parent="1"><mxGeometry x="700" y="1108" width="980" height="20" as="geometry"/></mxCell><mxCell id="p00n173" value="Edit freely — this page is the contract every other page keeps." style="text;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12.5;fontColor=#5A6B82;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="70" y="1150" width="1580" height="22.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p01" name="01 · Pipeline overview"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="830" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p01n1" value="OLake Go · pipeline overview" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=21;fontColor=#0B1220;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="56" y="24" width="1380" height="30" as="geometry"/></mxCell><mxCell id="p01n2" value="one process, one engine: drivers read, the engine plans and supervises, writers commit" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12.5;fontColor=#5A6B82;" vertex="1" parent="1"><mxGeometry x="56" y="57" width="1380" height="18" as="geometry"/></mxCell><mxCell id="p01n3" value="olake.io" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#BAC5D4;" vertex="1" parent="1"><mxGeometry x="1552" y="28" width="120" height="16" as="geometry"/></mxCell><mxCell id="p01n4" value="8 drivers" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;fillColor=#F4F7FA;strokeColor=#475A70;strokeWidth=1.6;dashed=0;verticalAlign=top;align=left;spacingTop=44;spacingLeft=18;fontFamily=Helvetica;fontSize=11.5;fontColor=#5A6B82;" vertex="1" parent="1"><mxGeometry x="56" y="120" width="236" height="500" as="geometry"/></mxCell><mxCell id="p01n5" value="&lt;b&gt;&lt;font style=&quot;font-size: 12.5px&quot; color=&quot;#FFFFFF&quot;&gt;Sources&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=40;html=1;fillColor=#475A70;strokeColor=none;fontFamily=Helvetica;fontSize=12.5;fontColor=#FFFFFF