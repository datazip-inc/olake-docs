nt style=&quot;font-size: 12.5px&quot; color=&quot;#0B1220&quot;&gt;olake_2pc&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10.8px&quot; color=&quot;#5A6B82&quot;&gt;committed thread IDs · last log&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10.8px&quot; color=&quot;#5A6B82&quot;&gt;position · dedup_inserts&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FCE7C2;strokeColor=#D97706;strokeWidth=1.8;fontFamily=Helvetica;fontSize=12.5;fontColor=#0B1220;align=left;spacingLeft=58;" vertex="1" parent="1"><mxGeometry x="96" y="438" width="284" height="86" as="geometry"/></mxCell><mxCell id="p10n13" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalAlign=top;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="112" y="467.0" width="28" height="28" as="geometry"/></mxCell><mxCell id="p10n14" value="all three become visible together, or none of them&lt;br/&gt;at all" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10.8;fontColor=#5A6B82;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="96" y="534" width="284" height="34.08" as="geometry"/></mxCell><mxCell id="p10n15" value="all-or-nothing" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;fillColor=#EDFAF3;strokeColor=#059669;strokeWidth=1.6;dashed=0;verticalAlign=top;align=left;spacingTop=44;spacingLeft=18;fontFamily=Helvetica;fontSize=11.5;fontColor=#5A6B82;" vertex="1" parent="1"><mxGeometry x="700" y="150" width="440" height="260" as="geometry"/></mxCell><mxCell id="p10n16" value="&lt;b&gt;&lt;font style=&quot;font-size: 12.5px&quot; color=&quot;#FFFFFF&quot;&gt;Iceberg table&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=40;html=1;fillColor=#059669;strokeColor=none;fontFamily=Helvetica;fontSize=12.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="716" y="136" width="126.7" height="28" as="geometry"/></mxCell><mxCell id="p10n17" value="" style="group" verte