B1220&quot;&gt;CDC · MySQL&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#0B1220;" vertex="1" parent="p03n97"><mxGeometry x="8" y="102" width="168" height="25" as="geometry"/></mxCell><mxCell id="p03n118" value="&lt;font style=&quot;font-size: 11px&quot; color=&quot;#0B1220&quot;&gt;binlog file + position, and the server ID&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#0B1220;" vertex="1" parent="p03n97"><mxGeometry x="186" y="102" width="356" height="25" as="geometry"/></mxCell><mxCell id="p03n119" value="&lt;font style=&quot;font-size: 11px&quot; color=&quot;#0B1220&quot;&gt;reconnects as the same replica, from that position&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#0B1220;" vertex="1" parent="p03n97"><mxGeometry x="552" y="102" width="390" height="25" as="geometry"/></mxCell><mxCell id="p03n120" value="" style="shape=line;strokeColor=#DEE5EE;strokeWidth=1;fillColor=none;" vertex="1" parent="p03n97"><mxGeometry x="0" y="127" width="944" height="1" as="geometry"/></mxCell><mxCell id="p03n121" value="&lt;font style=&quot;font-size: 11px&quot; color=&quot;#0B1220&quot;&gt;CDC · MongoDB&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#0B1220;" vertex="1" parent="p03n97"><mxGeometry x="8" y="127" width="168" height="25" as="geometry"/></mxCell><mxCell id="p03n122" value="&lt;font style=&quot;font-size: 11px&quot; color=&quot;#0B1220&quot;&gt;a resume token per stream&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#0B1220;" vertex="1" parent="p03n97"><mxGeometry x="186" y="127" width="356" height="25" as="geometry"/></mxCell><mxCell id="p03n123" value="&lt;font style=&quot;font-size: 11px&quot; color=&quot;#0B1220&quot;&gt;hands the token back via &lt;/font&gt;&lt;b&gt;&lt;font style=&quot;font-size: 11px&quot; color=&quot;#9A5408&quot; face=&quot;Courier New&quot;&gt;resumeAfter&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#0B1220;" vertex="1" parent="p03n97"><mxGeometry x="552" y="127" width="390" height="25" as="geometry"/></mxCell><mxCell id="p03n124" value="" style="shape=line;strokeColor=#DEE5EE;strokeWidth=1;fillColor=none;" vertex="1" parent="p03n97"><mxGeometry x="0" y="152" width="944" height="1" as="geometry"/></mxCell><mxCell id="p03n125" value="&lt;font style=&quot;font-size: 11px&quot; color=&quot;#0B1220&quot;&gt;CDC · SQL Server&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#0B1220;" vertex="1" parent="p03n97"><mxGeometry x="8" y="152" width="168" height="25" as="geometry"/></mxCell><mxCell id="p03n126" value="&lt;font style=&quot;font-size: 11px&quot; color=&quot;#0B1220&quot;&gt;the last LSN read per stream&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#0B1220;" vertex="1" parent="p03n97"><mxGeometry x="186" y="152" width="356" height="25" as="geometry"/></mxCell><mxCell id="p03n127" value="&lt;font style=&quot;font-size: 11px&quot; color=&quot;#0B1220&quot;&gt;polls the next LSN range&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#0B1220;" vertex="1" parent="p03n97"><mxGeometry x="552" y="152" width="390" height="25" as="geometry"/></mxCell><mxCell id="p03n128" value="" style="shape=line;strokeColor=#DEE5EE;strokeWidth=1;fillColor=none;" vertex="1" parent="p03n97"><mxGeometry x="0" y="177" width="944" height="1" as="geometry"/></mxCell><mxCell id="p03n129" value="&lt;font style=&quot;font-size: 11px&quot; color=&quot;#0B1220&quot;&gt;Kafka&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#0B1220;" vertex="1" parent="p03n97"><mxGeometry x="8" y="177" width="168" height="25" as="geometry"/></mxCell><mxCell id="p03n130" value="&lt;font style=&quot;font-size: 11px&quot; color=&quot;#0B1220&quot;&gt;consumer-group offsets, committed at the broker&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#0B1220;" vertex="1" parent="p03n97"><mxGeometry x="186" y="177" width="356" height="25" as="geometry"/></mxCell><mxCell id="p03n131" value="&lt;font style=&quot;font-size: 11px&quot; color=&quot;#0B1220&quot;&gt;resumes from the committed offset&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#0B1220;" vertex="1" parent="p03n97"><mxGeometry x="552" y="177" width="390" height="25" as="geometry"/></mxCell><mxCell id="p03n132" value="" style="shape=line;direction=north;strokeColor=#DEE5EE;strokeWidth=1;fillColor=none;" vertex="1" parent="p03n97"><mxGeometry x="178" y="0" width="1" height="202" as="geometry"/></mxCell><mxCell id="p03n133" value="" style="shape=line;direction=north;strokeColor=#DEE5EE;strokeWidth=1;fillColor=none;" vertex="1" parent="p03n97"><mxGeometry x="544" y="0" width="1" height="202" as="geometry"/></mxCell><mxCell id="p03n134" value="Values still in flight — the cursor maximum a reader is tracking, the log position it is advancing&lt;br/&gt;through — stay in driver memory and only enter state.json at a commit point. That is why the file&lt;br/&gt;never contains half-done progress: whenever the process dies, it already reflects exactly the units&lt;br/&gt;of work that completed, and nothing else." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11.5;fontColor=#5A6B82;" vertex="1" parent="1"><mxGeometry x="1050" y="700" width="600" height="65.80000000000001" as="geometry"/></mxCell><mxCell id="p03n135" value="The complete chunk list is persisted before any data moves (1–2); chunks run through a bounded pool (3) and each commits alone (4). Kill the process at any point: the next run reads the surviving list and re-runs only what is left." style="text;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12.5;fontColor=#5A6B82;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="70" y="956" width="1580" height="22.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p04" name="04 · CDC — sequential"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="700" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p04n1" value="Sequential CDC: one ordered log, one reader" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=21;fontColor=#0B1220;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="56" y="24" width="1380" height="30" as="geometry"/></mxCell><mxCell id="p04n2" value="PostgreSQL · MySQL — the whole database shares a single change log" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12.5;fontColor=#5A6B82;" vertex="1" parent="1"><mxGeometry x="56" y="57" width="1380" height="18" as="geometry"/></mxCell><mxCell id="p04n3" value="olake.io" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#BAC5D4;" vertex="1" parent="1"><mxGeometry x="1552" y="28" width="120" height="16" as="geometry"/></mxCell><mxCell id="p04n4" value="&lt;b&gt;&lt;font style=&quot;font-size: 13.5px&quot; color=&quot;#0B1220&quot;&gt;PostgreSQL&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10.6px&quot; color=&quot;#5A6B82&quot;&gt;or MySQL — one database&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#E6EBF2;strokeColor=#475A70;strokeWidth=1.8;fontFamily=Helvetica;fontSize=13;fontColor=#0B1220;verticalAlign=top;spacingTo