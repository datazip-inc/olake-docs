vertex="1" parent="1"><mxGeometry x="748" y="317.0" width="28" height="28" as="geometry"/></mxCell><mxCell id="p10n24" value="single atomic swap" style="html=1;edgeStyle=none;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=2.6;strokeColor=#059669;fontFamily=Helvetica;fontSize=11;fontColor=#046B4D;labelBackgroundColor=none;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="434" y="300" as="sourcePoint"/><mxPoint x="694" y="288" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p10n25" value="&lt;b&gt;&lt;font style=&quot;font-size: 13px&quot; color=&quot;#0B1220&quot;&gt;Next sync run&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10.8px&quot; color=&quot;#5A6B82&quot;&gt;opens the table first&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#DCE4FE;strokeColor=#193AE6;strokeWidth=1.8;align=left;spacingLeft=60;spacingRight=26;fontFamily=Helvetica;fontSize=13;fontColor=#0B1220;" vertex="1" parent="1"><mxGeometry x="700" y="500" width="240" height="74" as="geometry"/></mxCell><mxCell id="p10n26" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalAlign=top;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="915" y="507" width="17" height="17" as="geometry"/></mxCell><mxCell id="p10n27" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalAlign=top;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="718" y="523.0" width="28" height="28" as="geometry"/></mxCell><mxCell id="p10n28" value="&lt;b&gt;&lt;font style=&quot;font-size: 13px&quot; color=&quot;#0B1220&quot;&gt;Skips committed work&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10.8px&quot; color=&quot;#5A6B82&quot;&gt;chunk IDs and positions already done&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#DCE4FE;strokeColor=#193AE6;strokeWidth=1.8;align=left;spacingLeft=60;spacingRight=26;fontFamily=Helvetica;fontSize=13;fontColor=#0B1220;" vertex="1" parent="1"><mxGeometry x="1030" y="500" width="300" height="74" as="geometry"/></mxCell><mxCell id="p10n29" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalAlign=top;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1305" y="507" width="17" height="17" as="geometry"/></mxCell><mxCell id="p10n30" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalAlign=top;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1048" y="523.0" width="28" height="28" as="geometry"/></mxCell><mxCell id="p10n31" value="reads olake_2pc before doing anything" style="html=1;edgeStyle=none;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.8;strokeColor=#D97706;fontFamily=Helvetica;fontSize=11;fontColor=#9A5408;labelBackgroundColor=none;verticalAlign=bottom;dashed=1;dashPattern=6 4;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" target="p10n25"><mxGeometry relative="1" as="geometry"><mxPoint x="870" y="366" as="sourcePoint"/><Array as="points"><mxPoint x="820" y="456"/></Array></mxGeometry></mxCell><mxCell id="p10n32" value="" style="html=1;edgeStyle=none;rounded=1;endArrow=blockThin;endFill=1;endSize=8;strokeWidth=1.8;strokeColor=#33445A;fontFamily=Helvetica;fontSize=11;fontColor=#33445A;labelBackgroundColor=none;verticalAlign=bottom;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p10n25" target="p10n28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p10n33" value="No external coordinator and no transaction log of its own: the&lt;br/&gt;committed table is the only thing OLake trusts on restart. If the&lt;br/&gt;table is ahead of state.json, the table wins." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11.5;fontColor=#5A6B82;" vertex="1" parent="1"><mxGeometry x="1200" y="216" width="400" height="50.85" as="geometry"/></mxCell><mxCell id="p10n34" value="Every recovery path asks the destination the same question before it starts: what did you last durably record? Trusting the committed table over the local state file is what lets a plain stateless binary promise exactly-once." style="text;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12.5;fontColor=#5A6B82;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="70" y="630" width="1580" height="22.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p11" name="11 · The write path"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="660" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p11n1" value="Two runtimes, one destination" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=21;fontColor=#0B1220;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="56" y="24" width="1380" height="30" as="geometry"/></mxCell><mxCell id="p11n2" value="the hot data path stays in Go; catalogs and commits use the official Iceberg Java library" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12.5;fontColor=#5A6B82;" vertex="1" parent="1"><mxGeometry x="56" y="57" width="1380" height="18" as="geometry"/></mxCell><mxCell id="p11n3" value="olake.io" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#BAC5D4;" vertex="1" parent="1"><mxGeometry x="1552" y="28" width="120" height="16" as="geometry"/></mxCell><mxCell id="p11n4" value="the data path" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;fillColor=#EFF3FF;strokeColor=#193AE6;strokeWidth=1.6;dashed=0;verticalAlign=top;align=left;spacingTop=44;spacingLeft=18;fontFamily=Helvetica;fontSize=11.5;fontColor=#5A6B82;" vertex="1" parent="1"><mxGeometry x="56" y="140" width="500" height="420" a