;strokeWidth=1;fillColor=none;" vertex="1" parent="p09n47"><mxGeometry x="0" y="77" width="914" height="1" as="geometry"/></mxCell><mxCell id="p09n67" value="&lt;font style=&quot;font-size: 11px&quot; color=&quot;#9A5408&quot; face=&quot;Courier New&quot;&gt;i&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Courier New;fontSize=11;fontColor=#9A5408;" vertex="1" parent="p09n47"><mxGeometry x="8" y="77" width="86" height="25" as="geometry"/></mxCell><mxCell id="p09n68" value="&lt;font style=&quot;font-size: 11px&quot; color=&quot;#9A5408&quot;&gt;CDC&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#9A5408;" vertex="1" parent="p09n47"><mxGeometry x="104" y="77" width="158" height="25" as="geometry"/></mxCell><mxCell id="p09n69" value="&lt;font style=&quot;font-size: 11px&quot; color=&quot;#9A5408&quot;&gt;insert that may duplicate a backfilled row&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#9A5408;" vertex="1" parent="p09n47"><mxGeometry x="272" y="77" width="390" height="25" as="geometry"/></mxCell><mxCell id="p09n70" value="&lt;font style=&quot;font-size: 11px&quot; color=&quot;#9A5408&quot;&gt;equality delete + insert&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#9A5408;" vertex="1" parent="p09n47"><mxGeometry x="672" y="77" width="240" height="25" as="geometry"/></mxCell><mxCell id="p09n71" value="" style="shape=line;strokeColor=#DEE5EE;strokeWidth=1;fillColor=none;" vertex="1" parent="p09n47"><mxGeometry x="0" y="102" width="914" height="1" as="geometry"/></mxCell><mxCell id="p09n72" value="&lt;font style=&quot;font-size: 11px&quot; color=&quot;#0B1220&quot; face=&quot;Courier New&quot;&gt;u&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Courier New;fontSize=11;fontColor=#0B1220;" vertex="1" parent="p09n47"><mxGeometry x="8" y="102" width="86" height="25" as="geometry"/></mxCell><mxCell id="p09n73" value="&lt;font style=&quot;font-size: 11px&quot; color=&quot;#0B1220&quot;&gt;CDC · incremental&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#0B1220;" vertex="1" parent="p09n47"><mxGeometry x="104" y="102" width="158" height="25" as="geometry"/></mxCell><mxCell id="p09n74" value="&lt;font style=&quot;font-size: 11px&quot; color=&quot;#0B1220&quot;&gt;new version of an existing row&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#0B1220;" vertex="1" parent="p09n47"><mxGeometry x="272" y="102" width="390" height="25" as="geometry"/></mxCell><mxCell id="p09n75" value="&lt;font style=&quot;font-size: 11px&quot; color=&quot;#0B1220&quot;&gt;equality delete + insert&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#0B1220;" vertex="1" parent="p09n47"><mxGeometry x="672" y="102" width="240" height="25" as="geometry"/></mxCell><mxCell id="p09n76" value="" style="shape=line;strokeColor=#DEE5EE;strokeWidth=1;fillColor=none;" vertex="1" parent="p09n47"><mxGeometry x="0" y="127" width="914" height="1" as="geometry"/></mxCell><mxCell id="p09n77" value="&lt;font style=&quot;font-size: 11px&quot; color=&quot;#0B1220&quot; face=&quot;Courier New&quot;&gt;d&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Courier New;fontSize=11;fontColor=#0B1220;" vertex="1" parent="p09n47"><mxGeometry x="8" y="127" width="86" height="25" as="geometry"/></mxCell><mxCell id="p09n78" value="&lt;font style=&quot;font-size: 11px&quot; color=&quot;#0B1220&quot;&gt;CDC&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#0B1220;" vertex="1" parent="p09n47"><mxGeometry x="104" y="127" width="158" height="25" as="geometry"/></mxCell><mxCell id="p09n79" value="&lt;font style=&quot;font-size: 11px&quot; color=&quot;#0B1220&quot;&gt;delete captured from the change log&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#0B1220;" vertex="1" parent="p09n47"><mxGeometry x="272" y="127" width="390" height="25" as="geometry"/></mxCell><mxCell id="p09n80" value="&lt;font style=&quot;font-size: 11px&quot; color=&quot;#0B1220&quot;&gt;equality delete&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#0B1220;" vertex="1" parent="p09n47"><mxGeometry x="672" y="127" width="240" height="25" as="geometry"/></mxCell><mxCell id="p09n81" value="" style="shape=line;direction=north;strokeColor=#DEE5EE;strokeWidth=1;fillColor=none;" vertex="1" parent="p09n47"><mxGeometry x="96" y="0" width="1" height="152" as="geometry"/></mxCell><mxCell id="p09n82" value="" style="shape=line;direction=north;strokeColor=#DEE5EE;strokeWidth=1;fillColor=none;" vertex="1" parent="p09n47"><mxGeometry x="264" y="0" width="1" height="152" as="geometry"/></mxCell><mxCell id="p09n83" value="" style="shape=line;direction=north;strokeColor=#DEE5EE;strokeWidth=1;fillColor=none;" vertex="1" parent="p09n47"><mxGeometry x="664" y="0" width="1" height="152" as="geometry"/></mxCell><mxCell id="p09n84" value="&lt;b&gt;&lt;font style=&quot;font-size: 12.5px&quot; color=&quot;#9A5408&quot; face=&quot;Courier New&quot;&gt;i&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font style=&quot;font-size: 12.5px&quot; color=&quot;#0B1220&quot;&gt; only exists in the overlap window&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10.8px&quot; color=&quot;#5A6B82&quot;&gt;once it closes, inserts arrive as plain &lt;/font&gt;&lt;b&gt;&lt;font style=&quot;font-size: 10.8px&quot; color=&quot;#9A5408&quot; face=&quot;Courier New&quot;&gt;c&lt;/font&gt;&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FCE7C2;strokeColor=#D97706;strokeWidth=1.8;fontFamily=Helvetica;fontSize=12.5;fontColor=#0B1220;" vertex="1" parent="1"><mxGeometry x="1080" y="356" width="320" height="74" as="geometry"/></mxCell><mxCell id="p09n85" value="&lt;b&gt;&lt;font style=&quot;font-size: 12.5px&quot; color=&quot;#0B1220&quot;&gt;Incremental never emits &lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font style=&quot;font-size: 12.5px&quot; color=&quot;#0F2BB5&quot; face=&quot;Courier New&quot;&gt;d&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10.8px&quot; color=&quot;#5A6B82&quot;&gt;a row deleted at the source just stops appearing&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#E6EBF2;strokeColor=#475A70;strokeWidth=1.8;fontFamily=Helvetica;fontSize=12.5;fontColor=#0B1220;" vertex="1" parent="1"><mxGeometry x="1080" y="448" width="320" height="74" as="geometry"/></mxCell><mxCell id="p09n86" value="&lt;b&gt;&lt;font style=&quot;font-size: 12.5px&quot; color=&quot;#0B1220&quot;&gt;CDC has no such gap&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10.8px&quot; color=&quot;#5A6B82&quot;&gt;a delete is a real event on the change log&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#E6EBF2;strokeColor=#475A70;strokeWidth=1.8;fontFamily=Helvetica;fontSize=12.5;fontColor=#0B1220;" vertex="1" parent="1"><mxGeometry x="1080" y="540" width="320" height="74" as="geometry"/></mxCell><mxCell id="p09n87" value="This is why the destination never has&lt;br/&gt;to diff anything: the record already&lt;br/&gt;says what it is." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#5A6B82;" vertex="1" parent="1"><mxGeometry x="1440" y="356" width="224" height="48.9" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p10" name="10 · Exactly-once — the table is the ledger"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="680" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p10n1" value="Exactly-once delivery with no coordinator" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=21;fontColor=#0B1220;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="56" y="24" width="1380" height="30" as="geometry"/></mxCell><mxCell id="p10n2" value="each commit writes the data and the record of the data, in one Iceberg transaction" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12.5;fontColor=#5A6B82;" vertex="1" parent="1"><mxGeometry x="56" y="57" width="1380" height="18" as="geometry"/></mxCell><mxCell id="p10n3" value="olake.io" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#BAC5D4;" vertex="1" parent="1"><mxGeometry x="1552" y="28" width="120" height="16" as="geometry"/></mxCell><mxCell id="p10n4" value="staged together, visible together" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;fillColor=#EDFAF3;strokeColor=#059669;strokeWidth=1.6;dashed=0;verticalAlign=top;align=left;spacingTop=44;spacingLeft=18;fontFamily=Helvetica;fontSize=11.5;fontColor=#5A6B82;" vertex="1" parent="1"><mxGeometry x="56" y="140" width="372" height="440" as="geometry"/></mxCell><mxCell id="p10n5" value="&lt;b&gt;&lt;font style=&quot;font-size: 12.5px&quot; color=&quot;#FFFFFF&quot;&gt;One Iceberg transaction&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=40;html=1;fillColor=#059669;strokeColor=none;fontFamily=Helvetica;fontSize=12.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="72" y="126" width="205.70000000000002" height="28" as="geometry"/></mxCell><mxCell id="p10n6" value="" style="shape=note;html=1;size=12;fillColor=#FFFFFF;strokeColor=#8A9AB0;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="104" y="194" width="284" height="92" as="geometry"/></mxCell><mxCell id="p10