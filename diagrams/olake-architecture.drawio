lt;font style=&quot;font-size: 10.5px&quot; color=&quot;#9A5408&quot; face=&quot;Courier New&quot;&gt;_op_type&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10.5;fontColor=#9A5408;" vertex="1" parent="p09n21"><mxGeometry x="104" y="0" width="78" height="27" as="geometry"/></mxCell><mxCell id="p09n27" value="&lt;b&gt;&lt;font style=&quot;font-size: 10.5px&quot; color=&quot;#9A5408&quot; face=&quot;Courier New&quot;&gt;_olake_timestamp&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10.5;fontColor=#9A5408;" vertex="1" parent="p09n21"><mxGeometry x="192" y="0" width="130" height="27" as="geometry"/></mxCell><mxCell id="p09n28" value="&lt;b&gt;&lt;font style=&quot;font-size: 10.5px&quot; color=&quot;#9A5408&quot; face=&quot;Courier New&quot;&gt;_cdc_timestamp&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10.5;fontColor=#9A5408;" vertex="1" parent="p09n21"><mxGeometry x="332" y="0" width="120" height="27" as="geometry"/></mxCell><mxCell id="p09n29" value="" style="shape=line;strokeColor=#DEE5EE;strokeWidth=1;fillColor=none;" vertex="1" parent="p09n21"><mxGeometry x="0" y="27" width="454" height="1" as="geometry"/></mxCell><mxCell id="p09n30" value="&lt;font style=&quot;font-size: 11px&quot; color=&quot;#0B1220&quot; face=&quot;Courier New&quot;&gt;b7c2…&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Courier New;fontSize=11;fontColor=#0B1220;" vertex="1" parent="p09n21"><mxGeometry x="8" y="27" width="86" height="25" as="geometry"/></mxCell><mxCell id="p09n31" value="&lt;font style=&quot;font-size: 11px&quot; color=&quot;#0B1220&quot; face=&quot;Courier New&quot;&gt;c&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Courier New;fontSize=11;fontColor=#0B1220;" vertex="1" parent="p09n21"><mxGeometry x="104" y="27" width="78" height="25" as="geometry"/></mxCell><mxCell id="p09n32" value="&lt;font style=&quot;font-size: 11px&quot; color=&quot;#0B1220&quot; face=&quot;Courier New&quot;&gt;09:02:14&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Courier New;fontSize=11;fontColor=#0B1220;" vertex="1" parent="p09n21"><mxGeometry x="192" y="27" width="130" height="25" as="geometry"/></mxCell><mxCell id="p09n33" value="&lt;font style=&quot;font-size: 11px&quot; color=&quot;#0B1220&quot; face=&quot;Courier New&quot;&gt;09:02:11&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Courier New;fontSize=11;fontColor=#0B1220;" vertex="1" parent="p09n21"><mxGeometry x="332" y="27" width="120" height="25" as="geometry"/></mxCell><mxCell id="p09n34" value="" style="shape=line;direction=north;strokeColor=#DEE5EE;strokeWidth=1;fillColor=none;" vertex="1" parent="p09n21"><mxGeometry x="96" y="0" width="1" height="52" as="geometry"/></mxCell><mxCell id="p09n35" value="" style="shape=line;direction=north;strokeColor=#DEE5EE;strokeWidth=1;fillColor=none;" vertex="1" parent="p09n21"><mxGeometry x="184" y="0" width="1" height="52" as="geometry"/></mxCell><mxCell id="p09n36" value="" style="shape=line;direction=north;strokeColor=#DEE5EE;strokeWidth=1;fillColor=none;" vertex="1" parent="p09n21"><mxGeometry x="324" y="0" width="1" height="52" as="geometry"/></mxCell><mxCell id="p09n37" value="" style="group" vertex="1" connectable="0" parent="1"><mxGeometry x="1130" y="156" width="150" height="52" as="geometry"/></mxCell><mxCell id="p09n38" value="plus the source&#x27;s own position" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11.5;fontColor=#33445A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1132" y="130" width="300" height="18" as="geometry"/></mxCell><mxCell id="p09n39" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#475A70;strokeWidth=1.6;" vertex="1" parent="p09n37"><mxGeometry x="0" y="0" width="150" height="52" as="geometry"/></mxCell><mxCell id="p09n40" value="" style="rounded=0;html=1;fillColor=#E6EBF2;strokeColor=#475A70;strokeWidth=1.6;" vertex="1" parent="p09n37"><mxGeometry x="0" y="0" width="150" height="27" as="geometry"/></mxCell><mxCell id="p09n41" value="&lt;b&gt;&lt;font style=&quot;font-size: 10.5px&quot; color=&quot;#33445A&quot; face=&quot;Courier New&quot;&gt;_cdc_lsn&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10.5;fontColor=#33445A;" vertex="1" parent="p09n37"><mxGeometry x="8" y="0" width="140" height="27" as="geometry"/></mxCell><mxCell id="p09n42" value="" style="shape=line;strokeColor=#DEE5EE;strokeWidth=1;fillColor=none;" vertex="1" parent="p09n37"><mxGeometry x="0" y="27" width="150" height="1" as="geometry"/></mxCell><mxCell id="p09n43" value="&lt;font style=&quot;font-size: 11px&quot; color=&quot;#0B1220&quot; face=&quot;Courier New&quot;&gt;0/1A2B3C4D&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Courier New;fontSize=11;fontColor=#0B1220;" vertex="1" parent="p09n37"><mxGeometry x="8" y="27" width="140" height="25" as="geometry"/></mxCell><mxCell id="p09n44" value="one column per source: MySQL writes binlog file and position, MongoDB a resume&lt;br/&gt;token, Kafka partition and offset" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10.6;fontColor=#5A6B82;" vertex="1" parent="1"><mxGeometry x="1130" y="244" width="460" height="33.56" as="geometry"/></mxCell><mxCell id="p09n45" value="_olake_id is a hash of the primary key — the identity the destination deduplicates and upserts on. _op_type is how the writer knows what to do with the row." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11.5;fontColor=#5A6B82;" vertex="1" parent="1"><mxGeometry x="56" y="250" width="1000" height="21.5" as="geometry"/></mxCell><mxCell id="p09n46" value="Because the operation type travels with the record, the writer never has to guess: r and c append, u and d delete by _olake_id, and i is the one that makes the full-load-to-CDC overlap safe to replay." style="text;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12.5;fontColor=#5A6B82;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="70" y="670" width="1580" height="22.5" as="geometry"/></mxCell><mxCell id="p09n47" value="" style="group" vertex="1" connectable="0" parent="1"><mxGeometry x="56" y="356" width="914" height="152" as="geometry"/></mxCell><mxCell id="p09n48" value="the five operation types" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11.5;fontColor=#0F2BB5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="330" width="914" height="18" as="geometry"/></mxCell><mxCell id="p09n49" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#193AE6;strokeWidth=1.6;" vertex="1" parent="p09n47"><mxGeometry x="0" y="0" width="914" height="152" as="geometry"/></mxCell><mxCell id="p09n50" value="" style="rounded=0;html=1;fillColor=#DCE4FE;strokeColor=#193AE6;strokeWidth=1.6;" vertex="1" parent="p09n47"><mxGeometry x="0" y="0" width="914" height="27" as="geometry"/></mxCell><mxCell id="p09n51" value="&lt;b&gt;&lt;font style=&quot;font-size: 10.5px&quot; color=&quot;#0F2BB5&quot; face=&quot;Courier New&quot;&gt;_op_type&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10.5;fontColor=#0F2BB5;" vertex="1" parent="p09n47"><mxGeometry x="8" y="0" width="86" height="27" as="geometry"/></mxCell><mxCell id="p09n52" value="&lt;b&gt;&lt;font style=&quot;font-size: 10.5px&quot; color=&quot;#0F2BB5&quot;&gt;emitted by&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10.5;fontColor=#0F2BB5;" vertex="1" parent="p09n47"><mxGeometry x="104" y="0" width="158" height="27" as="geometry"/></mxCell><mxCell id="p09n53" value="&lt;b&gt;&lt;font style=&quot;font-size: 10.5px&quot; color=&quot;#0F2BB5&quot;&gt;meaning&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10.5;fontColor=#0F2BB5;" vertex="1" parent="p09n47"><mxGeometry x="272" y="0" width="390" height="27" as="geometry"/></mxCell><mxCell id="p09n54" value="&lt;b&gt;&lt;font style=&quot;font-size: 10.5px&quot; color=&quot;#0F2BB5&quot;&gt;how it lands&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10.5;fontColor=#0F2BB5;" vertex="1" parent="p09n47"><mxGeometry x="672" y="0" width="240" height="27" as="geometry"/></mxCell><mxCell id="p09n55" value="" style="shape=line;strokeColor=#DEE5EE;strokeWidth=1;fillColor=none;" vertex="1" parent="p09n47"><mxGeometry x="0" y="27" width="914" height="1" as="geometry"/></mxCell><mxCell id="p09n56" value="&lt;font style=&quot;font-size: 11px&quot; color=&quot;#0B1220&quot; face=&quot;Courier New&quot;&gt;r&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Courier New;fontSize=11;fontColor=#0B1220;" vertex="1" parent="p09n47"><mxGeometry x="8" y="27" width="86" height="25" as="geometry"/></mxCell><mxCell id="p09n57" value="&lt;font style=&quot;font-size: 11px&quot; color=&quot;#0B1220&quot;&gt;full load&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#0B1220;" vertex="1" parent="p09n47"><mxGeometry x="104" y="27" width="158" height="25" as="geometry"/></mxCell><mxCell id="p09n58" value="&lt;font style=&quot;font-size: 11px&quot; color=&quot;#0B1220&quot;&gt;row read during a backfill scan&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#0B1220;" vertex="1" parent="p09n47"><mxGeometry x="272" y="27" width="390" height="25" as="geometry"/></mxCell><mxCell id="p09n59" value="&lt;font style=&quot;font-size: 11px&quot; color=&quot;#0B1220&quot;&gt;plain append&lt;/font&gt;" style="text;html=1